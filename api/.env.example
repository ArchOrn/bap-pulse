PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/bappulse?sslmode=disable

# Path to the Firebase service account JSON file (local dev only).
# In production (Cloud Run), remove this line: ADC takes over automatically.
FIREBASE_CREDENTIALS_FILE=/path/to/firebase-service-account.json

# Comma-separated list of allowed CORS origins, or '*' to allow any.
# Permissive in dev (Flutter web picks a random port each run); lock down to
# explicit origins in production (e.g. https://app.bap-pulse.fr,https://bo.bap-pulse.fr).
CORS_ORIGINS=*
